SECRET_KEY=your_django_secret_key
DEBUG=True

# Kakao Developers
KAKAO_API_KEY=your_kakao_rest_api_key
# 카카오 콘솔에 *.apps.tossmini.com 도메인 등록 필요
KAKAO_JS_KEY=your_kakao_javascript_key

# 공공데이터포털 (data.go.kr) - 한국환경공단 전기자동차 충전소 API
# web·worker 두 서비스 모두에 설정한다 (worker: python manage.py poll_charger_status --loop)
PUBLIC_DATA_API_KEY=your_data_go_kr_service_key

# 앱인토스 — 설정하면 CORS를 https://<appName>.apps.tossmini.com / .private-apps.tossmini.com 으로 제한
TOSS_APP_NAME=
CORS_EXTRA_ORIGINS=

# 혼잡 해소 알림 (선택) — 콘솔에서 발급한 mTLS 인증서/키(PEM 본문 또는 파일 경로)와 검수 승인된 템플릿
TOSS_MTLS_CERT=
TOSS_MTLS_KEY=
# 빈자리 알림 템플릿 (변수: restAreaName)
TOSS_TEMPLATE_CONGESTION_CLEARED=
# 즐겨찾기 상태 알림 템플릿 (변수: restAreaName, statusLabel)
TOSS_TEMPLATE_FAVORITE_STATUS=

# 분석 (선택)
GA_MEASUREMENT_ID=
AMPLITUDE_API_KEY=

# DATABASE_URL=postgres://user:password@host:5432/dbname   # 미설정 시 SQLite 사용
